<layout>
  <elements>
    <div interactable="0">
      <rectangle
        max_width="800"
        padding="16"
        flex_direction="column"
        gap="8"
        color="background(opacity-0.8)" border_color="outline" border="2" round="8">

        <div flex_direction="column" padding="8" justify_content="space_evenly">
          <label wrap="1" color="primary" weight="bold" size="20" padding_left="16" padding_right="16" translation="ALTTAB.RELEASE_TO_FOCUS" />

          <!-- A simple separator -->
          <rectangle width="100%" height="2" color="outline" margin="16" />

          <div gap="8" flex_direction="row" >
            <div width="50%" gap="8" flex_direction="column" >
              <div width="100%">
                <label translation="ALTTAB.WHILE_AIMING" color="primary" size="24" padding_left="16" padding_right="16" />
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="W" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div flex_direction="row" wrap="1">
                  <label translation="ALTTAB.CLICK" color="on_background" wrap="1" size="20" padding_left="8" />
                  <label text="*" color="tertiary" wrap="1" size="20" padding_left="4" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="A" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.GRABALL" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Q" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.GRAB" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="D" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.DASH" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="E" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.EDIT" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="R" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.RECENTER" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="1~4" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.SET" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
            </div>
            <div width="50%" gap="8" flex_direction="column" >
              <div width="100%">
                <label translation="ALTTAB.GENERAL_BINDS" color="primary" size="24" padding_left="16" padding_right="16" />
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Super+Z" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.TOGGLE_CAPTURE" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Super+X" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.FOCUS_MODE" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Alt+F4" color="secondary" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.CLOSE" color="on_background" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <!-- A simple separator -->
              <rectangle width="100%" height="2" color="outline" margin="16" padding_right="16" />
              <div width="100%" flex_direction="row">
                  <label text="*" color="tertiary" wrap="1" size="20" padding_left="8" />
                  <label translation="ALTTAB.MOUSE" color="on_background" wrap="1" size="20" padding_left="4" padding_right="16" />
              </div>
            </div>
          </div>
        </div>
      </rectangle>
    </div>
  </elements>
</layout>
