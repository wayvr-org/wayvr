<layout version="2">
  <elements>
    <rectangle
      width="400"
      padding="16"
      flex_direction="column"
      gap="12"
      color="background" border_color="outline" border="2" round="8">

      <div flex_direction="row" justify_content="space_between" align_items="center" gap="16">
        <sprite id="sprite" color="primary" height="24" width="24" />
        <label id="label_title" color="primary" weight="bold" size="20" />
        <label id="label_value" color="on_background" weight="bold" size="20" />
      </div>

      <rectangle id="rect_track" width="100%" height="8" color="outline" round="4">
        <rectangle id="rect_level" width="100%" height="100%" color="primary" round="4" />
      </rectangle>
    </rectangle>
  </elements>
</layout>
